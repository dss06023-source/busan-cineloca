+def test_candidates_keeps_only_scores_near_the_top() -> None:
+    a, b, c = (Match("1", "가", 0.80, "trigram"), Match("2", "나", 0.76, "trigram"),
+               Match("3", "다", 0.74, "trigram"))  # fmt: skip
+    assert candidates([a, b, c]) == [a, b]  # 0.05 안만 같은 후보
