# 이름만 적는다. 값은 infra/.env(커밋 금지)에 넣는다. 설명은 docs/build-plan.md 3장.

# DB
POSTGRES_PASSWORD=
NOTICE_VERSION=2026-11-01

# AI (Gemini 무료 티어, 결제 미연결 프로젝트의 키)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDERS=gemini
# 로컬 LLM은 선택. 비워 두면 꺼짐
OLLAMA_LLM_URL=
# 테스트·장애 주입: AI_PROVIDERS=fake일 때 ok|timeout|429|500|bad_schema
FAKE_AI_MODE=ok

# 외부 데이터
KMDB_KEY=
KOBIS_KEY=
DATA_GO_KR_KEY=
JUSO_KEY=
TOUR_API_KEY=

# 프론트엔드 빌드 인자(브라우저에 노출됨, 카카오 콘솔에서 도메인 제한)
VITE_KAKAO_JS_KEY=

# 관리자·토큰
# 관리자 비밀번호 argon2 해시: cd backend && python -m app.tools.hash_password
ADMIN_PASSWORD_HASH=
# 형식: kid:비밀,kid:비밀(비밀 32바이트 이상, 앞의 키로 서명). 비우면 개발용 임시 키
TOKEN_KEYS=
