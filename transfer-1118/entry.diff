@@ -0,0 +1,146 @@
+"""C1 배치 실행: backend 폴더에서 python -m app.batch --once [--out 결과.json]
+
+환경변수 이름은 저장소 루트 .env.example과 같다. 저장소 루트 .env가 있으면 읽는다
+(scripts/ai_smoke.py와 같음, 이미 있는 환경변수는 덮지 않음). 다른 파일은 --env-file로 준다.
+  필수: DATABASE_URL, DATA_GO_KR_SERVICE_KEY
+  좌표: JUSO_SEARCH_API_KEY·JUSO_COORD_API_KEY(정확한 주소), KAKAO_REST_API_KEY(주소가 없거나
+        동까지만 있는 촬영지, #25). 없으면 그 좌표만 비워 두고 계속한다.
+  매칭: KMDB_SERVICE_KEY. 없으면 KMDB_CSV_PATH('영화기본정보' CSV)로 매칭한다.
+  선택: JUSO_BASE_URL(주소 API 주소를 바꿀 때)
+정기 실행(FR-616)은 아직 없고 --once 수동 실행만 한다.
+
+로그: 로그 설정 뒤 PrivacyLogFilter를 붙이고(#39), httpx·httpcore는 WARNING으로 올린다.
+httpx는 요청 URL(serviceKey·confmKey 포함)을 INFO로 남기기 때문이다.
+출력·결과 파일은 UTF-8로 쓴다(#26, Windows 콘솔·파일에서 한글이 깨지지 않게).
+"""
+
+import argparse
+import asyncio
+import json
+import logging
+import os
+import re
+import sys
+from collections.abc import MutableMapping
+from pathlib import Path
+
+import asyncpg
+import httpx
+
+from app.batch import job, kmdb
+from app.batch.geocode import DEFAULT_BASE, JusoGeocoder, KakaoKeywordGeocoder
+from app.support.privacy import install_privacy_log_filter
+
+log = logging.getLogger("app.batch")
+REQUIRED = ("DATABASE_URL", "DATA_GO_KR_SERVICE_KEY")
+_COMMENT = re.compile(r"(?:^|\s)#")
+ROOT_ENV = Path(__file__).resolve().parents[3] / ".env"
+ENV_HINT = "저장소 루트의 .env.example을 복사해 .env를 만들고 값을 채우세요"
+
+
+def setup_logging(level: str = "INFO") -> None:
+    logging.basicConfig(level=level)
+    install_privacy_log_filter()  # 핸들러를 만든 뒤 붙인다
+    for noisy in ("httpx", "httpcore"):
+        logging.getLogger(noisy).setLevel(logging.WARNING)
+
+
+def load_env_file(path: Path, env: MutableMapping[str, str] = os.environ) -> None:
+    """KEY=값 줄을 읽어 env에 없는 이름만 채운다. 값은 출력하지 않는다.
+
+    따옴표 없는 값은 '#'(맨 앞이거나 앞이 공백) 뒤를 주석으로 본다(.env.example의 설명 주석).
+    """
+    for line in path.read_text(encoding="utf-8-sig").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        name, value = (s.strip() for s in line.split("=", 1))
+        if value[:1] in ("'", '"') and value.count(value[0]) >= 2:
+            value = value[1 : value.index(value[0], 1)]
+        else:
+            value = _COMMENT.split(value, 1)[0].strip()
+        if name and name not in env:
+            env[name] = value
+
+
+def _env(env: MutableMapping[str, str], name: str) -> str:
+    return (env.get(name) or "").strip()
+
+
+def missing(env: MutableMapping[str, str] = os.environ) -> list[str]:
+    return [n for n in REQUIRED if not _env(env, n)]
+
+
+def build_clients(http: httpx.AsyncClient, env: MutableMapping[str, str] = os.environ):
+    """환경변수로 외부 연결을 만든다. 빠진 선택 키는 이름만 경고로 남긴다."""
+    skey, ckey = _env(env, "JUSO_SEARCH_API_KEY"), _env(env, "JUSO_COORD_API_KEY")
+    juso = (
+        JusoGeocoder(http, skey, ckey, _env(env, "JUSO_BASE_URL") or DEFAULT_BASE)
+        if skey and ckey
+        else None
+    )
+    kakao = (
+        KakaoKeywordGeocoder(http, _env(env, "KAKAO_REST_API_KEY"))
+        if _env(env, "KAKAO_REST_API_KEY")
+        else None
+    )
+    source: kmdb.CandidateSource | None = None
+    if _env(env, "KMDB_SERVICE_KEY"):
+        source = kmdb.KmdbApi(http, _env(env, "KMDB_SERVICE_KEY"))
+    elif _env(env, "KMDB_CSV_PATH"):
+        source = kmdb.KmdbCsv.load(_env(env, "KMDB_CSV_PATH"))
+    if juso is None:
+        log.warning("JUSO_SEARCH_API_KEY·JUSO_COORD_API_KEY가 없어 주소 좌표를 찾지 않습니다")
+    if kakao is None:
+        log.warning("KAKAO_REST_API_KEY가 없어 주소 없는 촬영지 좌표를 찾지 않습니다")
+    if source is None:
+        log.warning("KMDB_SERVICE_KEY·KMDB_CSV_PATH가 없어 KMDb 매칭을 하지 않습니다")
+    return job.Clients(http, _env(env, "DATA_GO_KR_SERVICE_KEY"), juso, kakao, source)
+
+
+async def main(trigger: str, out: Path | None) -> int:
+    if names := missing():
+        print(f"{', '.join(names)} 값이 없습니다. {ENV_HINT}", file=sys.stderr)
+        return 2
+    async with httpx.AsyncClient() as http:
+        clients = build_clients(http)
+        conn = await asyncpg.connect(_env(os.environ, "DATABASE_URL"))
+        try:
+            run_id, counts, stats = await job.run(conn, clients, trigger)
+            status = await conn.fetchval("SELECT status FROM sync_run WHERE id = $1", run_id)
+        finally:
+            await conn.close()
+    result = {
+        "run_id": run_id,
+        "status": status,
+        "counts": counts.model_dump(),
+        "stats": stats.__dict__,
+    }
+    text = json.dumps(result, ensure_ascii=False, indent=1)
+    print(text)
+    if out:
+        out.write_text(text + "\n", encoding="utf-8")
+    return 0 if status == "succeeded" else 1
+
+
+def cli(argv: list[str] | None = None) -> int:
+    for stream in (sys.stdout, sys.stderr):
+        if hasattr(stream, "reconfigure"):
+            stream.reconfigure(encoding="utf-8")
+    p = argparse.ArgumentParser(prog="python -m app.batch")
+    p.add_argument("--once", action="store_true", required=True, help="동기화 한 번 실행")
+    p.add_argument("--trigger", choices=["manual", "schedule"], default="manual")
+    p.add_argument("--env-file", type=Path, help="KEY=값 파일. 없으면 저장소 루트 .env")
+    p.add_argument("--out", type=Path, help="결과 JSON을 UTF-8 파일로도 저장")
+    a = p.parse_args(argv)
+    if a.env_file and not a.env_file.is_file():
+        print(f"{a.env_file} 파일이 없습니다. {ENV_HINT}", file=sys.stderr)
+        return 2
+    if (env_file := a.env_file or ROOT_ENV).is_file():
+        load_env_file(env_file)
+    setup_logging(_env(os.environ, "LOG_LEVEL") or "INFO")
+    return asyncio.run(main(a.trigger, a.out))
+
+
+if __name__ == "__main__":
+    sys.exit(cli())
diff --git a/backend/tests/test_batch_main.py b/backend/tests/test_batch_main.py
new file mode 100644
index 0000000..efa7a23
--- /dev/null
+++ b/backend/tests/test_batch_main.py
@@ -0,0 +1,73 @@
+"""C1 배치 진입점 테스트 (#26, #39). 키 값은 가짜이고 실제 API를 부르지 않는다."""
+
+import logging
+
+import httpx
+
+import app.batch.__main__ as batch_main
+from app.batch.__main__ import build_clients, cli, load_env_file, missing, setup_logging
+
+
+def test_load_env_file_reads_values_skips_comments_and_keeps_existing(tmp_path) -> None:
+    f = tmp_path / ".env"
+    f.write_text(
+        "﻿# 주석\nDATABASE_URL=postgresql://a\n"
+        "KMDB_SERVICE_KEY=         # 한국영상자료원 KMDb\n"
+        "JUSO_BASE_URL='http://x # y'\nDATA_GO_KR_SERVICE_KEY=from-file\n잘못된 줄\n",
+        encoding="utf-8",
+    )
+    env = {"DATA_GO_KR_SERVICE_KEY": "already"}
+    load_env_file(f, env)
+    assert env == {
+        "DATA_GO_KR_SERVICE_KEY": "already",
+        "DATABASE_URL": "postgresql://a",
+        "KMDB_SERVICE_KEY": "",
+        "JUSO_BASE_URL": "http://x # y",
+    }
+    assert missing(env) == []
+    assert missing({"DATABASE_URL": " "}) == ["DATABASE_URL", "DATA_GO_KR_SERVICE_KEY"]
+
+
+def test_cli_missing_env_points_to_root_env_example(monkeypatch, capsys, tmp_path) -> None:
+    for name in ("DATABASE_URL", "DATA_GO_KR_SERVICE_KEY"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setattr(batch_main, "ROOT_ENV", tmp_path / "no-root.env")  # 개발자 PC의 .env 무시
+    assert cli(["--once"]) == 2
+    assert "저장소 루트의 .env.example" in capsys.readouterr().err
+    assert cli(["--once", "--env-file", str(tmp_path / "none.env")]) == 2
+    assert "none.env 파일이 없습니다" in capsys.readouterr().err
+
+
+def test_build_clients_warns_names_only(caplog) -> None:
+    env = {"DATA_GO_KR_SERVICE_KEY": "D-SECRET", "KAKAO_REST_API_KEY": "K-SECRET"}
+    with caplog.at_level(logging.WARNING, logger="app.batch"):
+        c = build_clients(httpx.AsyncClient(), env)
+    assert c.data_go_kr_key == "D-SECRET" and c.kakao is not None
+    assert c.juso is None and c.kmdb_source is None
+    text = caplog.text
+    assert "JUSO_SEARCH_API_KEY" in text and "KMDB_SERVICE_KEY" in text
+    assert "SECRET" not in text
+
+
+def test_setup_logging_hides_keys_and_quiets_httpx(capsys) -> None:
+    root = logging.getLogger()
+    saved = (root.handlers[:], root.level)
+    levels = {n: logging.getLogger(n).level for n in ("httpx", "httpcore")}
+    root.handlers = []  # 배치를 처음 실행할 때처럼 핸들러가 없는 상태
+    try:
+        setup_logging()
+        assert all(logging.getLogger(n).level == logging.WARNING for n in levels)
+        logging.getLogger("app.batch.collect").warning(
+            "GET https://apis.data.go.kr/x?serviceKey=SECRET1&pageNo=1"
+        )
+        logging.getLogger("httpx").warning("GET https://juso/x?confmKey=SECRET2")
+        logging.getLogger("httpx").info("HTTP Request: 이 줄은 남지 않는다")
+    finally:
+        root.handlers = saved[0]
+        root.setLevel(saved[1])
+        for n, lv in levels.items():
+            logging.getLogger(n).setLevel(lv)
+    err = capsys.readouterr().err
+    assert "pageNo=1" in err and "confmKey=" in err
+    assert "SECRET1" not in err and "SECRET2" not in err
+    assert "이 줄은 남지 않는다" not in err
