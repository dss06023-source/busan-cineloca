+    load_jsonl,
+    retrieval_counts,
+    retrieval_scores,
+    run_f4,
+    run_redteam,
+    summarize_c1,
+    summarize_f4,
+    summarize_redteam,
+)
+
+EMPTY = {
+    "out_of_scope": False,
+    "work_titles": [],
+    "persons": [],
+    "genres": [],
+    "districts": [],
+    "release_year_from": None,
+    "release_year_to": None,
+    "anchor": None,
+    "travel": None,
+    "result_type": "location",
+}
+OOS = {**EMPTY, "out_of_scope": True}
