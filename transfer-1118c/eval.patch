+
+# ── 검색 정밀도·재현율 ────────────────────────────────────
+def test_retrieval_counts_and_scores():
+    assert retrieval_counts(["자갈치시장", "범일동 철길"], ["자갈치 시장", "광안대교"]) == (1, 2, 2)
